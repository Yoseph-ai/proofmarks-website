# ============================================
# Hedera Testnet (for UI demo – free tier)
# ============================================
HEDERA_OPERATOR_ID=0.0.xxxxx_testnet
HEDERA_OPERATOR_KEY=302e... (DER format)
HEDERA_NETWORK=testnet
TOPIC_ID=0.0.xxxxx_testnet_topic

# ============================================
# Hedera Mainnet (for Agent API – production)
# ============================================
MAINNET_OPERATOR_ID=0.0.xxxxx_mainnet
MAINNET_OPERATOR_KEY=302e... (DER format)
MAINNET_TOPIC_ID=0.0.xxxxx_mainnet_topic

# ============================================
# Agent API Authentication
# ============================================
AGENT_API_KEY=your-super-secret-key-here

# ============================================
# JWT (optional, for future receipts)
# ============================================
JWT_SECRET=your-jwt-secret-here

# ============================================
# Other (mirror node – default works)
# ============================================
# MIRROR_NODE_URL=https://mainnet.mirrornode.hedera.com